# Bot トークン（Developer Portal > Bot で取得）
DISCORD_TOKEN=your-bot-token-here
# アプリ ID（= Client ID）
CLIENT_ID=1521150303435489362
# テスト用サーバー ID。入れるとスラッシュコマンドが即時反映。空ならグローバル登録（最大1時間）。
GUILD_ID=
# コマンドを打てるユーザーID（カンマ区切り）。空なら全員可。
COMMAND_ALLOW=
# Go Live配信用のサブ垢ユーザートークン(/douga で使う。空なら /douga は動かない)
STREAM_TOKEN=
# gptsol(LLMチャット)用。OpenAI Responses API
OPENAI_API_KEY=
# 既定モデル(省略可。/model で sol/terra を切替できる)
OPENAI_MODEL=
# ディベート相手のAI(Claude_Code)用。空でも本体は動く
CLAUDE_TOKEN=
